{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clippy (CI)",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets --locked -- -D warnings",
      "group": "build",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "clippy all-features (CI)",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "test (CI)",
      "type": "shell",
      "command": "cargo test --workspace --locked",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "policy",
      "type": "shell",
      "command": "cargo xtask policy",
      "problemMatcher": []
    },
    {
      "label": "build release victory",
      "type": "shell",
      "command": "cargo build --release -p victory",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "fmt check",
      "type": "shell",
      "command": "cargo fmt --all -- --check",
      "problemMatcher": []
    }
  ]
}
